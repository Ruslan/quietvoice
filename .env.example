# ============================================================================
# QuietVoice configuration
# Remote spoken I/O for AI coding agents over Telegram. No local mic/speakers.
# Works on macOS and Linux. TTS = crispasr; audio understanding = llama.cpp Gemma.
# ============================================================================

# --- Control plane: MCP endpoint ---
MCP_LISTEN=:8090
# Optional bearer token required on POST /rpc (leave empty for local dev).
MCP_API_TOKEN=
# Public URL shown to users in the Telegram /start onboarding (optional).
MCP_PUBLIC_URL=

# --- Telegram transport (long polling; no public URL needed) ---
QUIET_VOICE_BOT_TOKEN=
# Numeric IDs only (comma-separated for multiple). Empty = allow anyone (dev only!).
QUIET_VOICE_USER_ID=
# Chat that receives spoken updates and waiting notices, and whose voice is
# accepted (required). For a DM bot this equals your user id.
QUIET_VOICE_CHAT_ID=
# Legacy aliases still honored: TELEGRAM_BOT_TOKEN / TELEGRAM_ALLOWED_USER_IDS /
# TELEGRAM_ALLOWED_CHAT_IDS / TELEGRAM_DEFAULT_CHAT_ID

# --- Inference plane selection ---
# local  = monolith, inference runs in this process on the host GPU/CPU.
# remote = talk to a separate inference node (cmd/inferenced) over HTTP.
INFERENCE_MODE=local
# Only for INFERENCE_MODE=remote:
INFERENCE_URL=
INFERENCE_TOKEN=
# Listen address when THIS process runs as the inference node (cmd/inferenced):
INFERENCE_LISTEN=:9095

# --- Local inference: binaries (looked up on PATH if not absolute) ---
# Used only when the matching *_SERVER_URL below is unset (exec fallback).
CRISPASR_BIN=crispasr
LLAMA_MTMD_BIN=llama-mtmd-cli
ASR_LANG=ru

# --- Hot-model servers (optional, recommended for a GPU node) ---
# When set, that leaf call goes over HTTP to a persistent server with the model
# kept resident, instead of spawning a CLI per request. Leave empty to exec.
# Start the servers separately (one model per crispasr --server instance):
#   crispasr --server --backend qwen3-tts  -m $TTS_MODEL --codec-model $TTS_CODEC_MODEL \
#            --voice-dir ./voices --port 9100
#   crispasr --server --backend voxtral4b  -m $VOXTRAL_MODEL -l ru --port 9101
#   crispasr --server --backend whisper    -m $WHISPER_MODEL -l ru --port 9102
#   llama-server -m $GEMMA_MODEL --mmproj $GEMMA_MMPROJ --jinja --port 9200
TTS_SERVER_URL=
GEMMA_SERVER_URL=
VOXTRAL_SERVER_URL=
WHISPER_SERVER_URL=
# Replica pools (Layer 1): give a role several interchangeable backends and
# inferenced routes each request to an idle one — same single client contract,
# more throughput. Comma-separated; folds together with the singular var above.
# Launch N crispasr --server instances on consecutive ports (see tts-pool.sh).
#   TTS_SERVER_URLS=http://127.0.0.1:9100,http://127.0.0.1:9101,http://127.0.0.1:9102
TTS_SERVER_URLS=
GEMMA_SERVER_URLS=
VOXTRAL_SERVER_URLS=
WHISPER_SERVER_URLS=
# Legacy alias for VOICE_NAME (see "Reference voice" below); still honored.
TTS_VOICE=
# Shared bearer token if the servers were started with CRISPASR_API_KEYS.
INFERENCE_SERVER_API_KEY=

# --- TTS (crispasr / qwen3-tts) ---
# 0.6B Q8_0 (fast, ~530 MB) shown; see cache for 1.7B and Q4_K variants.
TTS_MODEL=~/.cache/crispasr/qwen3-tts-12hz-0.6b-base-q8_0.gguf
TTS_CODEC_MODEL=~/.cache/crispasr/qwen3-tts-tokenizer-12hz.gguf
# Optional voice cloning reference for LOCAL (monolith) mode (WAV + transcription):
TTS_VOICE_REF=./voices/ded.wav
TTS_REF_TEXT=

# --- Reference voice (owned by the control plane) ---
# In remote mode the MCP uploads this voice to whatever inference node it points
# at (POST /v1/voices, before the first say), so an inference node can be deployed
# with NO voice baked in and switching/restarting nodes re-registers it.
VOICE_NAME=ded
# Local path (on the MCP host) to the reference WAV. A few seconds is plenty.
VOICE_WAV=./voices/ded.wav
# The reference transcript: either a path to a text file OR the literal text.
VOICE_TXT=./voices/ded.txt

# --- Gemma 4 multimodal (llama.cpp) for audio -> intent ---
GEMMA_MODEL=~/models/google_gemma-4-E4B-it-Q4_K_M.gguf
GEMMA_MMPROJ=~/models/mmproj-google_gemma-4-E4B-it-f16.gguf

# --- ASR ensemble for literal + assisted modes (crispasr) ---
# Every configured recognizer transcribes the audio; in assisted mode ALL
# transcripts are handed to Gemma to reconcile (multi-hypothesis correction).
# Configure any subset — one recognizer, both, or many:
VOXTRAL_MODEL=~/.cache/crispasr/voxtral-mini-4b-realtime-q4_k.gguf
WHISPER_MODEL=~/.cache/crispasr/ggml-large-v3-turbo.bin
# Add arbitrary extra recognizers (semicolon-separated "name=backend:/path"):
# ASR_RECOGNIZERS=parakeet=parakeet:/path/parakeet.gguf;canary=whisper:/path/canary.bin

# --- Storage & scratch ---
STORE_PATH=voice_sessions/state.json
WORK_DIR=voice_sessions/work
VOICE_DOWNLOAD_DIR=voice_sessions/incoming

# --- Voice behaviour ---
LISTEN_WAIT_TIMEOUT=10m
SAY_CONTEXT_COUNT=2
# How listen_voice turns audio into text:
#   assisted  (default) — Voxtral produces an accurate literal transcript, then
#                         Gemma shapes it into concise intent WITHOUT re-inventing
#                         mis-heard technical words. Most reliable; two inferences.
#   intent              — Gemma interprets the audio directly. Uses prosody but can
#                         mis-hear/paraphrase technical terms.
#   literal             — Voxtral verbatim transcript only, no intent shaping.
#   clean_text          — Gemma polishes dictation into a written message.
LISTEN_MODE=assisted
